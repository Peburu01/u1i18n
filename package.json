{
  "name": "u1i18n-astro",
  "version": "0.2.0",
  "description": "Zero-markup i18n for Astro: translate your site without t() calls. A Vite plugin finds every piece of copy at build time, keeps links and formatting as placeholders, and serves per-locale JSON catalogs.",
  "keywords": [
    "astro",
    "astro-integration",
    "withastro",
    "i18n",
    "internationalization",
    "l10n",
    "localization",
    "translation",
    "multilingual",
    "vite-plugin",
    "vite",
    "zero-markup",
    "automatic-extraction",
    "translation-catalog",
    "json-catalog",
    "indic"
  ],
  "homepage": "https://github.com/Peburu01/u1i18n#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Peburu01/u1i18n.git"
  },
  "bugs": {
    "url": "https://github.com/Peburu01/u1i18n/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.ts",
    "./message": "./src/message.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@astrojs/compiler-rs": "^0.5.3",
    "entities": "^4.5.0"
  },
  "peerDependencies": {
    "vite": "*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "typescript": "^5.9.3",
    "vite": "*"
  },
  "files": [
    "src",
    "LICENSE",
    "README.md"
  ]
}
